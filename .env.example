# ===========================================
# Environment Variables — copy to .env
# ===========================================

# OpenRouter — LLM text/reasoning gateway
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxx

# OpenAI — embeddings (text-embedding-3-large), Whisper, GPT-4o Vision
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx

# Qdrant Cloud — remote vector database
QDRANT_CLOUD_URL=https://xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx.us-east-1-0.aws.cloud.qdrant.io:6333
QDRANT_CLOUD_API_KEY=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# Cloudflare D1 — Serverless SQL
CF_ACCOUNT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
CF_D1_DATABASE_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
CF_API_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Optional — default OpenRouter model
OPENROUTER_MODEL=openai/gpt-4o-mini
